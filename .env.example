# Copy to .env, replace BOTH tokens with distinct random values of 24+ characters.
# Load with: set -a; source .env; set +a
# No public demo accounts are enabled automatically.
COSMOS_USERS='{"REPLACE_WITH_RANDOM_OPERATOR_TOKEN":{"id":"operator-1","role":"operator"},"REPLACE_WITH_RANDOM_SUPERVISOR_TOKEN":{"id":"supervisor-1","role":"supervisor"}}'
COSMOS_WORKFLOW_DB=data/workflow.sqlite3
COSMOS_AUDIT_LOG=audit/decisions.jsonl
# Enable experimental helmet inference only after installing the GPU worker.
COSMOS_INFERENCE_ENABLED=0
COSMOS_UPLOAD_DIR=uploads
COSMOS_MAX_PENDING_JOBS=20
COSMOS_JOB_TIMEOUT_SECONDS=300
COSMOS_LEGACY_STREAM_ENABLED=0
# Reuse the model downloaded by scripts/benchmark.py (run from the project root).
HF_HUB_CACHE=data/huggingface
COSMOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
